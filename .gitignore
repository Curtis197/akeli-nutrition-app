# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
.env.local
.env.*
token.txt

# Editors
.vscode/
.idea/
.obsidian/
*.swp
*.tmp

# Flutter / Dart build outputs
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# iOS generated / ephemeral (not committed)
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/

# Android generated
android/.gradle/
android/local.properties

# Android signing — never commit these
android/key.properties
android/app/*.keystore
android/app/*.jks

# Python bytecode
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo

# Supabase local state
supabase/.branches/
supabase/.temp/

# Utility scripts (may contain embedded credentials)
migration_out.txt
reset_out.txt
test_users.sql

# Unsplash credentials
lib/features/cooking/unsplash

# Local test/debug scripts
analyze_user*.js
generate_migrations.js
test_*.js

# Apple signing keys — never commit
*.p8

# Google Cloud service account keys — never commit
afro-health-*.json
